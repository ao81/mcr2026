//**************************************************************************
// sensor.ino  ラインの判定と、センサ表（tables.h）の検索
//**************************************************************************

//**********************************************************************
// クロスライン検出  戻り値 0:なし 1:あり
//   中央2本を除いた左3本・右3本の両方に白線がある状態
//**********************************************************************
int check_crossline(void) {
    unsigned char b = sensor_inp(MASK3_3);
    unsigned char left  = b & 0xe0;   // 左3本
    unsigned char right = b & 0x07;   // 右3本
    // 左3本: 111 / 011 / 110 / 101、右3本: 111 / 101 / 011 / 110 のどれか
    bool left_ok  = (left  == 0xe0 || left  == 0x60 || left  == 0xc0 || left  == 0xa0);
    bool right_ok = (right == 0x07 || right == 0x05 || right == 0x03 || right == 0x06);
    return (left_ok && right_ok) ? 1 : 0;
}

//**********************************************************************
// 右ハーフライン検出  戻り値 0:なし 1:あり
//**********************************************************************
int check_shasenhenkoum(void) {
    unsigned char m = sensor_inp(MASK4_4);
    if (m == 0x0f || m == 0x1f || m == 0x1d || m == 0x1b || m == 0x17 ||
        m == 0x3f || m == 0x3d || m == 0x3b || m == 0x3e || m == 0x37) {
        return 1;
    }
    return 0;
}

//**********************************************************************
// 左ハーフライン検出  戻り値 0:なし 1:あり
//**********************************************************************
int check_shasenhenkouh(void) {
    unsigned char h = sensor_inp(MASK4_4);
    if (h == 0xf0 || h == 0xf8 || h == 0xb8 || h == 0xd8 || h == 0xe8 ||
        h == 0xfc || h == 0xbc || h == 0xdc || h == 0xec || h == 0x7c) {
        return 1;
    }
    return 0;
}

//**********************************************************************
// 左ハーフライン検出後のクロスライン再確認  戻り値 0:なし 1:あり
//   右3本に白線があれば「左ハーフラインではなくクロスライン」と判断する
//   ※ 0x04（右から3本目だけ白）は元のプログラムどおり対象外
//**********************************************************************
int check_hidarikakunin(void) {
    unsigned char h = sensor_inp(MASK0_3);
    if (h == 0x07 || h == 0x03 || h == 0x06 || h == 0x05 || h == 0x01 || h == 0x02) {
        return 1;
    }
    return 0;
}

//**********************************************************************
// ラインの通過時間を測る（元: kyori_flug / kyoritime の処理）
//   引数 on_line : 今ラインの上にいるか（1:いる 0:いない）
//   ラインに乗って → 降りた時点の cnt1 を line_pass_ms に記録し、状態を PASS_DONE にする
//**********************************************************************
void measure_line_pass(int on_line) {
    if (line_pass_state == PASS_WAIT && on_line == 1) {
        line_pass_state = PASS_ON_LINE;
    } else if (line_pass_state == PASS_ON_LINE && on_line == 0) {
        line_pass_state = PASS_DONE;
        line_pass_ms = cnt1;
    }
}

//**********************************************************************
// 表の中から sensor と同じ値の位置を探す  戻り値 位置（見つからなければ -1）
//**********************************************************************
int find_sensor(const uint8_t* list, int n, unsigned char sensor) {
    for (int i = 0; i < n; i++) {
        if (list[i] == sensor) return i;
    }
    return -1;
}

//**********************************************************************
// 表の1項目を実行する（KEEP の項目は変更しない）
//**********************************************************************
void apply_act(const Act& act) {
    if (act.ang != KEEP) ha(act.ang);
    if (act.ml != KEEP) sp(act.ml, act.mr);
}

//**********************************************************************
// センサ値を表で探して実行する  戻り値 見つかった位置（見つからなければ -1）
//**********************************************************************
int apply_table(const uint8_t* list, const Act* acts, int n, unsigned char sensor) {
    int i = find_sensor(list, n, sensor);
    if (i >= 0) apply_act(acts[i]);
    return i;
}

//**********************************************************************
// v を lo〜hi の範囲に収める
//**********************************************************************
int clamp_int(int v, int lo, int hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}
